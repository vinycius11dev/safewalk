NODE_ENV=development
PORT=4010
HOST=0.0.0.0
# Saltos de proxy confiaveis (0 = desligado). Atras do Passenger/proxy reverso, use 1.
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=safewalk
DB_USER=safewalk_app
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-random-secret-at-least-32-characters
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
PUBLIC_WEB_URL=http://localhost:8081
# Painel da Prefeitura (links de redefinição de senha dos operadores).
ADMIN_PANEL_URL=http://localhost:5190
DEMO_MODE=true
ALERT_WORKER_ENABLED=true
# SMTP com TLS direto (porta 465). Usado nos convites, alertas e na recuperação de senha.
# Em desenvolvimento sem SMTP, "Esqueci minha senha" devolve o link na resposta para teste.
SAFEWALK_SMTP_HOST=
SAFEWALK_SMTP_PORT=465
SAFEWALK_SMTP_USER=
SAFEWALK_SMTP_PASSWORD=
SAFEWALK_SMTP_FROM=
SAFEWALK_SMTP_SECURE=false
SAFEWALK_REPORT_PHOTO_DIR=
# Servicos geograficos (vazio = servidores comunitarios; em producao exigem ALLOW_COMMUNITY_GEO_SERVICES=true).
PHOTON_BASE_URL=
VALHALLA_BASE_URL=
GEOGRAPHIC_SERVICES_ENABLED=true
ALLOW_COMMUNITY_GEO_SERVICES=false
# Em NODE_ENV=production a API recusa iniciar com valores de exemplo, DEMO_MODE=true ou ALERT_WORKER_ENABLED=false.
